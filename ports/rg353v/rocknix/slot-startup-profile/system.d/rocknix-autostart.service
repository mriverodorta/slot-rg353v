[Unit]
Description=Slot RG353V hardware setup
Wants=slot-gpu-prepare.service
After=userconfig.service systemd-tmpfiles-setup.service slot-gpu-prepare.service
Before=slot-rg353v.service

[Service]
Type=oneshot
Environment=HOME=/storage
ExecStart=/usr/bin/slot-hardware-start
RemainAfterExit=yes
TimeoutStartSec=45

[Install]
WantedBy=rocknix.target
