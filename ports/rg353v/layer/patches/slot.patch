--- a/crates/slot/src/boot_time.rs
+++ b/crates/slot/src/boot_time.rs
@@ -4,9 +4,45 @@ use std::time::Instant;
 static START: OnceLock<Instant> = OnceLock::new();
 
 pub fn mark(phase: &str) {
+    #[cfg(all(feature = "rg353v", target_os = "linux"))]
+    record(phase);
+    #[cfg(feature = "rg353v")]
+    crate::boot_splash::mark(phase);
     eprintln!("slot: boot: {phase} at {:.1} ms", ms());
 }
 
 pub fn ms() -> f64 {
     START.get_or_init(Instant::now).elapsed().as_secs_f64() * 1e3
 }
+
+#[cfg(all(feature = "rg353v", target_os = "linux"))]
+fn record(phase: &str) {
+    use std::io::Write;
+    use std::path::Path;
+    let root = Path::new("/run/slot-boot");
+    if std::env::var_os("SLOT_BOOT_SPLASH").is_none()
+        || !root.join("events").is_dir()
+        || root.join("frontend.displayed").exists()
+        || !phase.bytes().all(|c| c.is_ascii_lowercase() || c == b' ')
+    {
+        return;
+    }
+    let mut clock = libc::timespec {
+        tv_sec: 0,
+        tv_nsec: 0,
+    };
+    // Record before framebuffer cleanup and before writing diagnostic metadata.
+    if unsafe { libc::clock_gettime(libc::CLOCK_MONOTONIC, &mut clock) } != 0 {
+        return;
+    }
+    let folder = root.join("frontend");
+    if std::fs::create_dir_all(&folder).is_ok() {
+        if let Ok(mut file) = std::fs::OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .open(folder.join(phase.replace(' ', "-")))
+        {
+            let _ = writeln!(file, "{}.{:09}", clock.tv_sec, clock.tv_nsec);
+        }
+    }
+}
