+        assert_eq!(QuickRow::Screenshots.parent(), Some(QuickRow::System));
+        assert_eq!(QuickRow::Gallery.parent(), None);
+        let t = tempfile::tempdir().unwrap();
+        std::fs::create_dir(t.path().join("Config")).unwrap();
+        slot_store::write_slot_state(t.path(), &a.state).unwrap();
+        let read = slot_store::read_slot_state(t.path());
+        assert!(!read.screenshot_shaders);
+        assert!(!read.screenshot_filters);
+        assert!(read.screenshot_overlay);
+    }
+}
