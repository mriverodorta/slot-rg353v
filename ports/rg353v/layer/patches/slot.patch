+) {
+    let (tex, w, h) = face;
+    let pad = MENU_PAD as f32;
+    let scale = ((OUT_W as f32 - 2.0 * QUICK_EDGE + 2.0 * pad) / w.max(1) as f32).min(1.0);
+    if selected {
+        out.push(Draw::Rect {
+            x: 0.0,
+            y: y + BAR_INSET,
+            w: OUT_W as f32,
+            h: pitch - 2.0 * BAR_INSET,
+            colour: edge(),
+        });
+    }
+    out.push(Draw::Tex {
+        x: QUICK_EDGE - pad * scale,
+        y: y + (pitch - h as f32 * scale) / 2.0,
+        w: w as f32 * scale,
+        h: h as f32 * scale,
