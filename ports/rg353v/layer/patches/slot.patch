+        assert!(shot.shaders);
+        assert!(shot.filters);
+        assert!(!shot.overlay);
+        assert_eq!(shot.game, "Zelda");
+        assert!(!t.path().join("Screenshots").exists());
+        a.in_game_menu = Some(QuickRow::Resume);
+        a.apply(Action::Screenshot);
