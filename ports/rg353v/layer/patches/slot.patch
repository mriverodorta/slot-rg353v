+    #[test]
+    fn an_unfinished_open_does_not_wait_on_the_frame_thread() {
+        let root = tempfile::tempdir().unwrap();
+        let mut session = Session::boot_with(root.path().into(), Box::new(StubSink::new()));
+        let (release, blocked) = std::sync::mpsc::channel();
+        let join = std::thread::spawn(move || {
+            // Timeout bounds a regression that accidentally joins here.
+            blocked.recv_timeout(Duration::from_secs(2)).unwrap();
+            Loaded {
+                opened: Opened {
+                    core: Box::new(MockCore::new()),
+                    named: true,
+                },
