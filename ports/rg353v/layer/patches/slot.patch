+    pub fn draw_panel_legend(&self, out: &mut Vec<Draw>) {
+        if self.gallery.is_some() {
+            return;
+        }
+        if self.shutting_down()
+            || matches!(self.phase, Phase::Doze { .. })
+            || self.in_game_menu.is_some() && !self.pause_visible()
+        {
+            return;
+        }
+        if self.settings_info.is_some()
+            || self.selected_settings_info().is_some()
+            || self.binding_dialog()
+            || self.pause_action()
+            || self.gallery.is_some()
+            || self.help.is_some()
+            || self.diagnostics.is_some()
+            || self.content_open
+            || self.network.is_some()
+            || self.updates.is_some()
+            || self.power_menu.is_some()
+        {
+            self.draw_custom_legend(out);
+        } else if let Some(row) = self.in_game_menu {
+            if let Some(faces) = &self.quick_menu_faces {
+                if row.game_button().is_some() {
+                    slot_ui::draw_menu_legend(&faces.controls, out);
+                } else {
+                    slot_ui::draw_setting_legend(faces, row.opens(), out);
+                }
+            }
+        } else if matches!(self.phase, Phase::Shelf) && self.wifi_connected {
+            slot_ui::draw_shelf_wifi(self.shelf_clock, footer_ink(self.light()), out);
+        } else if let Phase::QuickMenu { row } = self.phase {
+            if let Some(faces) = &self.quick_menu_faces {
+                if row.game_button().is_some()
+                    || row.shortcut().is_some()
+                    || row.carousel_action().is_some()
+                {
+                    slot_ui::draw_menu_legend(&faces.controls, out);
+                } else if self.quick_locked(row) {
+                    slot_ui::draw_menu_legend(&[faces.legend[0]], out);
+                } else {
+                    slot_ui::draw_setting_legend(faces, row.opens(), out);
+                }
+            }
+        } else if let Phase::SetClock {
+            picker, from_menu, ..
+        } = &self.phase
+        {
+            let hint = self.clock_faces.map(|(_, hint)| hint);
+            let back = self
+                .quick_menu_faces
+                .as_ref()
+                .filter(|_| *from_menu)
+                .map(|faces| faces.legend[0]);
+            picker.draw_legend(hint, back, out);
+        }
