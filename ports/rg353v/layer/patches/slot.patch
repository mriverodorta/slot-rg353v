+        for (system, ext) in [("GB", "gb"), ("GBC", "gbc"), ("GBA", "gba")] {
+            let folder = root.join("Games").join(system);
+            std::fs::create_dir_all(&folder).unwrap();
+            std::fs::write(folder.join(format!("Test.{ext}")), b"fixture").unwrap();
+        }
+        scan(root).unwrap()
+    }
+    #[test]
+    fn gpsp_only_hides_gb_gbc_and_blocks_start_without_writing_preferences() {
+        let root = tempfile::tempdir().unwrap();
+        let carts = carts(root.path());
+        assert_eq!(carts.len(), 3);
+        slot_store::write_selected_core(root.path(), "Test", Core::Mgba).unwrap();
+        let before = std::fs::read(root.path().join(slot_store::SELECTED_CORE_FILE)).unwrap();
+        let mut app = App::with_features(
+            carts,
+            crate::features::Features::parse("slot-features-v1\nemulator-gpsp\n"),
+        );
+        app.root = Some(root.path().to_path_buf());
+        assert_eq!(app.carts().count(), 1);
+        assert!(app.carts().all(|c| c.platform == Platform::Gba));
+        assert!(!app.core_switchable());
+        assert_eq!(app.resolve_core("Test", Platform::Gba), Some(Core::Gpsp));
+        app.apply(Action::GbaDown(Btn::Start));
+        assert!(app.core_picker().is_none());
+        assert_eq!(
+            std::fs::read(root.path().join(slot_store::SELECTED_CORE_FILE)).unwrap(),
+            before
+        );
+        assert_eq!(
+            scan(root.path()).unwrap().len(),
+            3,
+            "unsupported ROMs were removed"
+        );
+    }
+    #[test]
+    fn content_refresh_and_recents_do_not_restore_unsupported_systems() {
+        let root = tempfile::tempdir().unwrap();
+        let all = carts(root.path());
+        let mut app = App::with_features(
+            all.clone(),
+            crate::features::Features::parse("slot-features-v1\nemulator-gpsp\n"),
+        );
+        app.state.show_recents = true;
+        app.state.recents = Platform::ALL
+            .into_iter()
+            .map(|platform| slot_store::Recent {
+                platform,
+                stem: "Test".into(),
+            })
+            .collect();
+        app.restock_recents();
+        assert_eq!(app.shelves[0].1.carts.len(), 1);
+        let refresh = crate::content::Refresh {
+            carts: all,
+            wallpapers: vec![],
+            changed_labels: Default::default(),
+            changed_wallpapers: Default::default(),
+            issues: vec![],
+        };
+        app.refresh_content(&refresh);
+        assert!(app
+            .shelves
+            .iter()
+            .flat_map(|(_, s)| &s.carts)
+            .all(|c| c.platform == Platform::Gba));
+        assert_eq!(
+            app.state.recents.len(),
+            3,
+            "hidden recents must be preserved"
+        );
+        assert_eq!(app.shelves[0].1.carts.len(), 1);
+        app.shelf_at = 0;
+        assert_eq!(
+            app.next_shelf(1),
+            app.shelves
+                .iter()
+                .position(|(p, _)| *p == Some(Platform::Gba)),
+            "system navigation must skip GB/GBC"
+        );
+    }
+    #[test]
+    fn mgba_only_keeps_three_systems_and_has_no_picker_but_both_allow_it() {
+        let root = tempfile::tempdir().unwrap();
+        let carts = carts(root.path());
+        let mut app = App::with_features(
+            carts.clone(),
+            crate::features::Features::parse("slot-features-v1\nemulator-mgba\n"),
+        );
+        app.root = Some(root.path().to_path_buf());
+        assert_eq!(app.carts().count(), 3);
+        assert_eq!(app.resolve_core("Test", Platform::Gba), Some(Core::Mgba));
+        for i in 0..app.shelves.len() {
+            app.shelf_at = i;
+            app.open_core_picker();
+            assert!(app.core_picker().is_none());
+        }
+        let mut both = App::with_features(carts, crate::features::Features::default());
+        both.root = Some(root.path().to_path_buf());
+        both.shelf_at = both
+            .shelves
+            .iter()
+            .position(|(p, _)| *p == Some(Platform::Gba))
+            .unwrap();
+        assert!(both.core_switchable());
+        both.open_core_picker();
