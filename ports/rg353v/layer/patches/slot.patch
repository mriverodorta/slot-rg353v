+}
+
+const DIRECTIONS: [Btn; 4] = [Btn::Up, Btn::Down, Btn::Left, Btn::Right];
+
+impl DeviceEvents {
+    pub fn new(profile: InputProfile, name: &str) -> Self {
+        Self {
