+            );
+            a.flush_eject("Portable");
+            assert_eq!(read_slot_state(system.path()).cart, None);
+            assert!(!card.path().join("Config/slot.state").exists());
+            assert!(!other.join("Saves").exists());
+            assert!(!other.join("States").exists());
