+            let system = tempfile::tempdir().unwrap();
+            let card = tempfile::tempdir().unwrap();
+            std::fs::create_dir_all(system.path().join("Config")).unwrap();
+            std::fs::create_dir_all(card.path().join("Games/GBA")).unwrap();
+            std::fs::write(card.path().join("Games/GBA/Portable.gba"), vec![0; 0x200]).unwrap();
+            if game {
+                std::fs::write(system.path().join("Config/save-location"), "game\n").unwrap();
