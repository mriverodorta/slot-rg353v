+    #[test]
+    fn legacy_capture_filter_setting_preserves_shader_choice() {
+        let t = tempfile::tempdir().unwrap();
+        std::fs::create_dir(t.path().join("Config")).unwrap();
+        slot_store::write_slot_state(t.path(), &slot_store::SlotState::default()).unwrap();
+        let path = t.path().join("Config/slot.state");
+        let legacy = std::fs::read_to_string(&path)
+            .unwrap()
+            .replace("screenshot_shaders=1\n", "")
+            .replace("screenshot_filters=1\n", "screenshot_filters=0\n");
+        std::fs::write(&path, &legacy).unwrap();
+        let read = slot_store::read_slot_state(t.path());
+        assert!(!read.screenshot_shaders);
+        assert!(!read.screenshot_filters);
+        std::fs::write(&path, format!("{legacy}screenshot_shaders=1\n")).unwrap();
+        let read = slot_store::read_slot_state(t.path());
+        assert!(read.screenshot_shaders);
+        assert!(!read.screenshot_filters);
+    }
+    #[test]
+    fn screenshot_configuration_has_three_independent_persisted_toggles() {
+        let mut a = App::new(vec![]);
+        assert!(a.state.screenshot_shaders);
+        assert!(a.state.screenshot_filters);
+        assert!(!a.state.screenshot_overlay);
+        a.change_setting(QuickRow::ScreenshotShaders, true);
+        assert!(!a.state.screenshot_shaders);
+        assert!(a.state.screenshot_filters);
+        a.change_setting(QuickRow::ScreenshotFilters, true);
+        assert!(!a.state.screenshot_filters);
+        assert!(!a.state.screenshot_overlay);
+        a.change_setting(QuickRow::ScreenshotOverlay, true);
+        assert!(!a.state.screenshot_filters);
+        assert!(a.state.screenshot_overlay);
+        assert_eq!(
