+#[test]
+fn sleep_shutdown_cycles_persists_and_changes_the_active_deadline() {
+    use std::time::Duration;
+    let (d, mut a, _) = on_carousel();
+    a.set_power(common::panel(d.path(), Duration::from_secs(180)).0);
+    open_at(&mut a, QuickRow::SleepShutdown);
+    let choices = [
+        (5, QuickValue::Minutes5),
+        (15, QuickValue::Minutes15),
+        (30, QuickValue::Minutes30),
+        (60, QuickValue::Minutes60),
+        (0, QuickValue::Never),
+        (3, QuickValue::Minutes3),
+    ];
+    for (minutes, value) in choices {
+        press(&mut a, Btn::Right);
+        a.flush_state();
+        assert_eq!(a.quick_value(QuickRow::SleepShutdown), Some(value));
+        assert_eq!(read_slot_state(d.path()).sleep_shutdown_minutes, minutes);
+    }
+    press(&mut a, Btn::Left);
+    assert_eq!(
+        a.quick_value(QuickRow::SleepShutdown),
+        Some(QuickValue::Never)
+    );
+    press(&mut a, Btn::B);
+    press(&mut a, Btn::B);
+    a.apply(Action::LidClose);
+    a.update(3601.0);
+    assert!(
+        !a.powering_off(),
+        "Never must disable only the sleep deadline"
+    );
+    a.apply(Action::LidOpen);
+    open_at(&mut a, QuickRow::SleepShutdown);
+    press(&mut a, Btn::Right);
+    press(&mut a, Btn::B);
+    press(&mut a, Btn::B);
+    a.apply(Action::LidClose);
+    a.update(179.0);
+    assert!(!a.powering_off());
+    a.update(1.1);
+    assert!(
+        a.powering_off(),
+        "Restoring 3 Min must update the live deadline"
+    );
+}
