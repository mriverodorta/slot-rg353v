+
+/// Shared lazy metadata, reused by shell type and finish. Explicit content/media
+/// refresh invalidates the generation; no file stat/open occurs on a cache hit.
+#[derive(Clone)]
+struct CachedHeader {
+    header: Option<Header>,
+    class: Class,
+}
+fn headers(
+) -> &'static std::sync::Mutex<std::collections::HashMap<std::path::PathBuf, CachedHeader>> {
+    static CACHE: std::sync::OnceLock<
+        std::sync::Mutex<std::collections::HashMap<std::path::PathBuf, CachedHeader>>,
+    > = std::sync::OnceLock::new();
+    CACHE.get_or_init(Default::default)
+}
+fn cached(rom: &Path) -> CachedHeader {
+    let mut cache = headers().lock().unwrap_or_else(|e| e.into_inner());
+    cache
+        .entry(rom.to_path_buf())
+        .or_insert_with(|| {
+            let mut bytes = Vec::with_capacity(HEADER_LEN);
+            let read =
+                File::open(rom).and_then(|f| f.take(HEADER_LEN as u64).read_to_end(&mut bytes));
+            if read.is_err() {
+                bytes.clear();
+            }
+            CachedHeader {
+                header: Header::parse(&bytes),
+                class: class_of(bytes.get(CGB_OFF as usize).copied()),
+            }
+        })
+        .clone()
+}
+pub fn cached_header(rom: &Path) -> Option<Header> {
+    cached(rom).header
+}
+pub fn cached_class(rom: &Path) -> Class {
+    cached(rom).class
+}
+pub fn clear_header_cache() {
+    headers().lock().unwrap_or_else(|e| e.into_inner()).clear();
+}
