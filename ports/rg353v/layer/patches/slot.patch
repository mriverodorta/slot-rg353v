+#[cfg(feature = "rg353v")]
+#[test]
+fn physical_volume_and_brightness_work_in_network_power_and_clock_menus() {
+    for page in ["network", "power", "clock"] {
+        let (_root, mut app, _clock) = on_carousel_with(SlotState {
+            volume: 50,
+            brightness: 5,
+            ..SlotState::default()
+        });
+        match page {
+            "network" => {
+                open_at(&mut app, QuickRow::Network);
+                press(&mut app, Btn::A);
+                assert!(app.network_open());
+            }
+            "power" => app.apply(Action::PowerHold),
+            _ => {
+                open_at(&mut app, QuickRow::SetClock);
+                press(&mut app, Btn::A);
+            }
+        }
+        app.apply(Action::VolumeUp);
+        assert_eq!(app.volume(), 55, "volume is swallowed by {page}");
+        app.apply(Action::VolumeDown);
+        assert_eq!(app.volume(), 50);
+        app.apply(Action::BrightnessUp);
+        assert_eq!(app.brightness(), 6, "brightness is swallowed by {page}");
+        app.apply(Action::BrightnessDown);
+        assert_eq!(app.brightness(), 5);
+    }
+}
