+                resume: Ok(None),
+            }
+        });
+        session.opening = Some(Opening { join: Some(join) });
+        assert!(session.core_settling());
+        assert!(session.has_core());
+        assert!(
+            !session.finish_opening(),
+            "frame thread waited for the core open"
+        );
+        assert!(session.emu.is_none());
+        release.send(()).unwrap();
+        let deadline = std::time::Instant::now() + Duration::from_secs(2);
+        while !session.finish_opening() {
+            assert!(std::time::Instant::now() < deadline);
+            std::thread::yield_now();
+        }
+        assert!(session.opening.is_none());
+        assert!(session.emu.is_some());
+    }
+
+    #[test]
