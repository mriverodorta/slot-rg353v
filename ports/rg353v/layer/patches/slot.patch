+    fn pause_input(&mut self, row: QuickRow, action: Action) {
+        if matches!(action, Action::GbaDown(_)) {
+            self.pause_reveal_at = self.now();
+        }
+        match action {
+            Action::GameMenu | Action::QuickMenu => self.in_game_menu = None,
+            Action::GbaDown(Btn::B) => {
+                self.in_game_menu = match row {
+                    QuickRow::GameBorder
+                    | QuickRow::OverlayStyle
+                    | QuickRow::FrameCounter
+                    | QuickRow::Palette => Some(QuickRow::PlayScreen),
+                    _ => row.parent_in_game(),
+                };
+                self.in_game_first = 0;
+            }
+            Action::GbaDown(Btn::Up) | Action::GbaDown(Btn::Down) => {
+                let rows = self.pause_rows(row);
+                let n = rows.len();
+                if n == 0 {
+                    return;
+                }
+                let at = rows.iter().position(|r| *r == row).unwrap_or(0);
+                let next = rows[(at
+                    + if action == Action::GbaDown(Btn::Down) {
+                        1
+                    } else {
+                        n - 1
+                    })
+                    % n];
+                self.in_game_menu = Some(next);
+                self.in_game_first = slot_ui::menu_window(
+                    n,
+                    rows.iter().position(|r| *r == next).unwrap_or(0),
+                    7,
+                    self.in_game_first,
+                )
+                .start;
+            }
+            Action::GbaDown(Btn::Left) | Action::GbaDown(Btn::Right) | Action::GbaDown(Btn::A) => {
+                if action == Action::GbaDown(Btn::A) {
+                    match row {
+                        QuickRow::Resume => {
