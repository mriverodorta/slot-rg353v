+#[cfg(feature = "rg353v")]
+fn miami_initial_offset(utc: i64) -> i16 {
+    use slot_store::{civil_from_days, days_from_civil};
+    const DAY: i64 = 86_400;
+    let (year, _, _) = civil_from_days(utc.div_euclid(DAY));
+    if year < 2007 {
+        return -300;
+    }
+    // America/New_York: second Sunday in March at 07:00 UTC through
+    // first Sunday in November at 06:00 UTC. No network or process startup.
+    let march = days_from_civil(year, 3, 1);
+    let november = days_from_civil(year, 11, 1);
+    let second_sunday = march + (7 - (march + 4).rem_euclid(7)) % 7 + 7;
+    let first_sunday = november + (7 - (november + 4).rem_euclid(7)) % 7;
+    if (second_sunday * DAY + 7 * 3600..first_sunday * DAY + 6 * 3600).contains(&utc) {
+        -240
+    } else {
+        -300
+    }
+}
