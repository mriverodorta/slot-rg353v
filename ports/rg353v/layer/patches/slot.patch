+        assert!(!a.features.visible(QuickRow::Gallery));
+        for row in [
+            QuickRow::Screenshots,
+            QuickRow::ScreenshotShaders,
+            QuickRow::ScreenshotFilters,
+            QuickRow::ScreenshotOverlay,
+            QuickRow::ScScreenshot,
+        ] {
+            assert!(a.features.visible(row));
+        }
+        let entry = a
+            .binding_table()
+            .entries()
+            .into_iter()
+            .find(|e| e.action == Action::Screenshot)
+            .unwrap();
+        assert_eq!(
+            entry.chord,
+            slot_input::Chord {
+                modifier: Some(slot_input::Mod::Select),
+                button: Btn::Start
