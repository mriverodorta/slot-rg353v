+#[cfg(feature = "rg353v")]
+#[test]
+fn rg353v_top_hud_is_separate_from_the_scene_and_hidden_during_doze() {
+    let (_root, mut app, _clock) = on_carousel();
+    app.apply(Action::VolumeUp);
+    let (mut scene, mut overlay) = (Vec::new(), Vec::new());
+    app.draw_panel(&mut scene, &mut overlay);
+    let plate = |draw: &Draw| {
+        matches!(*draw, Draw::Rect { x: 0.0, y: 0.0, w, h, .. }
+        if w == slot_gfx::OUT_W as f32 && h == slot_ui::PLATE_H)
+    };
+    assert!(
+        overlay.iter().any(plate),
+        "volume plate never reached the panel overlay"
+    );
+    assert!(
+        !scene.iter().any(plate),
+        "volume plate was also drawn in the offset scene"
+    );
+    app.apply(Action::PowerTap);
+    assert!(matches!(app.phase(), Phase::Doze { .. }));
+    overlay.clear();
+    app.draw_panel(&mut Vec::new(), &mut overlay);
+    assert!(overlay.is_empty(), "HUD relit the dozing screen");
+}
