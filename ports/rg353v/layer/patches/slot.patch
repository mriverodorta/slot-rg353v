+
+/// Draw directly in the footer: no glyph texture or deferred asset dependency.
+pub fn draw_shelf_wifi(clock: Printed, ink: [u8; 3], out: &mut Vec<Draw>) {
+    if clock.w == 0 {
+        return;
+    }
+    const ROWS: [&str; 14] = [
+        "000011111111110000",
+        "001111111111111100",
+        "011100000000001110",
+        "111000000000000111",
+        "000000000000000000",
+        "000001111111100000",
+        "000111111111111000",
+        "001110000000011100",
+        "000000000000000000",
+        "000000011110000000",
+        "000000111111000000",
+        "000000000000000000",
+        "000000001100000000",
+        "000000001100000000",
+    ];
+    let x = OUT_W as f32 - FOOTER_MARGIN - clock.w as f32 - 10.0 - 18.0;
+    let y = FOOTER_Y + (HINT_H as f32 - 14.0) / 2.0;
+    for (row, bits) in ROWS.iter().enumerate() {
+        let mut start = None;
+        for (col, bit) in bits.bytes().chain(std::iter::once(b'0')).enumerate() {
+            if bit == b'1' {
+                start.get_or_insert(col);
+            } else if let Some(first) = start.take() {
+                out.push(Draw::Rect {
+                    x: x + first as f32,
+                    y: y + row as f32,
+                    w: (col - first) as f32,
+                    h: 1.0,
+                    colour: [
+                        ink[0] as f32 / 255.0,
+                        ink[1] as f32 / 255.0,
+                        ink[2] as f32 / 255.0,
+                        1.0,
+                    ],
+                });
+            }
+        }
+    }
+}
+
+pub fn draw_pause_status(
+    battery: Option<Battery>,
+    percent: Printed,
+    bolt: Option<TexId>,
+    clock: Printed,
+    out: &mut Vec<Draw>,
+) {
+    draw_gauge(16.0, 12.0, battery, percent, bolt, [255; 3], out);
+    draw_printed(OUT_W as f32 - 16.0 - clock.w as f32, 8.0, clock, out);
+}
+
+#[cfg(test)]
+mod wifi_tests {
+    use super::*;
+    #[test]
+    fn wifi_is_texture_free_and_left_of_fixed_clock_on_footer_baseline() {
+        let mut out = Vec::new();
+        draw_shelf_wifi(Printed::default(), [255; 3], &mut out);
+        assert!(out.is_empty());
+        let clock = Printed::new(TexId::from_raw(1), 48);
+        draw_shelf_wifi(clock, [255; 3], &mut out);
+        assert!(!out.is_empty());
+        let mut right = f32::NEG_INFINITY;
+        let mut top = f32::INFINITY;
+        let mut bottom = f32::NEG_INFINITY;
+        for draw in out {
+            let Draw::Rect { x, y, w, h, .. } = draw else {
+                panic!("Wi-Fi depends on a texture");
+            };
+            right = right.max(x + w);
+            top = top.min(y);
+            bottom = bottom.max(y + h);
+        }
+        assert_eq!(right + 10.0, OUT_W as f32 - FOOTER_MARGIN - clock.w as f32);
+        assert_eq!((top + bottom) / 2.0, FOOTER_Y + HINT_H as f32 / 2.0);
+    }
+}
