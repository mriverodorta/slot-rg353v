+#[test]
+fn perfect_overrides_and_fps_round_trip_without_replacing_normal_preferences() {
+    let root = tempfile::tempdir().unwrap();
+    std::fs::create_dir_all(root.path().join("Config")).unwrap();
+    let state = slot_store::SlotState {
+        perfect_shader_gba: Some(slot_store::Shader::Grid),
+        perfect_shader_gb: Some(slot_store::Shader::Off),
+        perfect_colour_correction: Some(false),
+        show_fps: false,
+        ..slot_store::SlotState::default()
+    };
+    slot_store::write_slot_state(root.path(), &state).unwrap();
+    assert_eq!(slot_store::read_slot_state(root.path()), state);
+    let path = root.path().join("Config/slot.state");
+    let text = std::fs::read_to_string(&path).unwrap();
+    std::fs::write(
+        &path,
+        text.lines()
+            .filter(|l| {
+                !l.starts_with("perfect_shader_")
+                    && !l.starts_with("perfect_colour_")
+                    && !l.starts_with("show_fps=")
+            })
+            .collect::<Vec<_>>()
+            .join("\n"),
+    )
+    .unwrap();
+    let old = slot_store::read_slot_state(root.path());
+    assert!(old.show_fps);
+    assert_eq!(old.perfect_shader_gba, None);
+    assert_eq!(old.perfect_shader_gb, None);
+    assert_eq!(old.perfect_colour_correction, None);
+}
