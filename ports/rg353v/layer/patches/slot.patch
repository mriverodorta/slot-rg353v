+    pub fn refresh_content(&mut self, refresh: &crate::content::Refresh) {
+        slot_store::gb::clear_header_cache();
+        let selected_before = self.selected_stem().map(str::to_string);
+        let mut catalog = refresh
+            .carts
+            .iter()
+            .filter(|c| self.features.supports(c.platform))
+            .cloned()
+            .collect::<Vec<_>>();
+        for cart in &mut catalog {
+            if let Some(old) = self.carts().find(|c| c.rom == cart.rom) {
+                cart.title.clone_from(&old.title);
+                cart.code.clone_from(&old.code);
+            }
+        }
+        let selected_shelf = self.shelf_at;
+        for (at, (platform, shelf)) in self.shelves.iter_mut().enumerate() {
+            let carts = if let Some(platform) = platform {
+                catalog
+                    .iter()
+                    .filter(|c| c.platform == *platform)
+                    .cloned()
+                    .collect()
+            } else if at == 1 && self.state.player_features.enabled(PlayerFeature::Favorites) {
+                self.state
+                    .favorites
+                    .iter()
+                    .filter_map(|r| {
+                        catalog
+                            .iter()
+                            .find(|c| c.platform == r.platform && c.stem == r.stem)
+                            .cloned()
+                    })
+                    .collect()
+            } else if at == 0 && self.state.show_recents {
+                self.state
+                    .recents
+                    .iter()
+                    .filter_map(|r| {
+                        catalog
+                            .iter()
+                            .find(|c| c.platform == r.platform && c.stem == r.stem)
+                            .cloned()
+                    })
+                    .collect()
+            } else {
+                Vec::new()
+            };
+            self.orphaned
+                .extend(shelf.refresh(carts, &refresh.changed_labels));
+        }
+        self.restock_favorites();
+        if self.shelves[selected_shelf].1.carts.is_empty() {
+            self.shelf_at = self.next_shelf(1).unwrap_or(0);
+        }
+        if self.slot_cart.is_some() && selected_before.as_deref() != self.selected_stem() {
+            self.name_selected_cart();
+        }
+        self.content_wallpapers = Some(refresh.wallpapers.clone());
+        if self
+            .random_wallpaper
+            .as_ref()
+            .and_then(|p| p.as_ref())
+            .is_some_and(|n| !refresh.wallpapers.contains(n))
+        {
+            self.random_wallpaper = None;
+        }
+        self.content_status = vec![format!(
+            "{} games, {} wallpapers",
+            refresh.carts.len(),
+            refresh.wallpapers.len()
+        )];
+        if let Some(root) = &self.root {
+            let roots = slot_store::library_roots(root);
+            if roots.len() > 1 {
+                let names = roots[1..]
+                    .iter()
+                    .filter_map(|p| p.file_name()?.to_str())
+                    .collect::<Vec<_>>()
+                    .join(", ");
+                self.content_status
+                    .push(format!("SD libraries: {names} (read only)"));
+            }
+        }
+        if refresh.issues.is_empty() {
+            self.content_status.push("Content is up to date".into());
+        } else {
+            self.content_status
+                .push(format!("{} file issues (see below)", refresh.issues.len()));
+            for issue in refresh.issues.iter().take(2) {
+                if let Some((file, reason)) = issue.rsplit_once(": ") {
+                    self.content_status.push(file.into());
+                    self.content_status.push(reason.into());
+                }
+            }
+            if refresh.issues.len() > 2 {
+                self.content_status
+                    .push("Full report: Diagnostics/content.log".into());
+            }
+        }
+    }
