@@ -1,5 +1,46 @@
 use crate::surface::{OUT_H, OUT_W};
 
+pub fn game_panel_rect(
+    panel: (u32, u32),
+    source: (u32, u32),
+    stretch: bool,
+) -> (i32, i32, i32, i32) {
+    let (w, h) = if stretch {
+        panel
+    } else {
+        let scale = (panel.0 as f32 / source.0 as f32).min(panel.1 as f32 / source.1 as f32);
+        (
+            (source.0 as f32 * scale).round() as u32,
+            (source.1 as f32 * scale).round() as u32,
+        )
+    };
+    (
+        (panel.0 as i32 - w as i32) / 2,
+        if !stretch && source == (240, 160) {
+            panel.1 as i32 - h as i32
+        } else {
+            (panel.1 as i32 - h as i32) / 2
+        },
+        w as i32,
+        h as i32,
+    )
+}
+
+/// Integer viewport in OpenGL's bottom-left coordinates. GBA is top aligned.
+pub fn integer_game_panel_rect(panel: (u32, u32), source: (u32, u32)) -> (i32, i32, i32, i32) {
+    if source.0 == 0 || source.1 == 0 || panel.0 < source.0 || panel.1 < source.1 {
+        return game_panel_rect(panel, (source.0.max(1), source.1.max(1)), false);
+    }
+    let scale = (panel.0 / source.0).min(panel.1 / source.1);
+    let (w, h) = (source.0 * scale, source.1 * scale);
+    let y = if source == (240, 160) {
+        panel.1 - h
+    } else {
+        (panel.1 - h) / 2
+    };
+    (((panel.0 - w) / 2) as i32, y as i32, w as i32, h as i32)
+}
+
 pub fn framed(panel: (u32, u32)) -> bool {
     panel.0 > 0 && panel.0 * 3 == panel.1 * 4
 }
