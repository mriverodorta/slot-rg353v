+
+    pub fn on(self, core: Core) -> Blending {
+        match (core, self) {
+            (Core::Gpsp, Blending::Ghosting) => Blending::Mix,
+            (_, blending) => blending,
+        }
+    }
+
+    pub fn key(self) -> &'static str {
+        match self {
