+mod initial_clock_tests {
+    use super::*;
+    use slot_store::days_from_civil;
+
+    fn utc(year: i64, month: i64, day: i64, hour: i64) -> i64 {
+        days_from_civil(year, month, day) * 86_400 + hour * 3600
+    }
+
+    #[test]
+    fn miami_default_follows_seasons_and_exact_dst_boundaries() {
+        for (stamp, offset) in [
+            (utc(2026, 1, 20, 12), -300),
+            (utc(2026, 10, 20, 12), -240),
+            (utc(2026, 3, 8, 7) - 1, -300),
+            (utc(2026, 3, 8, 7), -240),
+            (utc(2026, 11, 1, 6) - 1, -240),
+            (utc(2026, 11, 1, 6), -300),
+            (utc(2027, 3, 14, 7), -240),
+            (utc(2027, 11, 7, 6), -300),
+        ] {
+            assert_eq!(miami_initial_offset(stamp), offset);
+            let Phase::SetClock {
+                picker, from_menu, ..
+            } = initial_clock_screen(stamp)
+            else {
+                panic!("fresh installs must still show clock setup");
+            };
+            assert!(!from_menu);
+            assert_eq!(picker.offset_min(), i64::from(offset));
+            assert_eq!(picker.secs(), stamp - stamp.rem_euclid(60));
+        }
+    }
+
+    #[test]
+    fn fresh_install_still_waits_for_clock_confirmation() {
+        let root = tempfile::tempdir().unwrap();
