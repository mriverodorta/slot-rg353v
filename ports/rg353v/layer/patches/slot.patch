+    pub fn menu_legend(&self) -> Vec<slot_ui::Hint> {
+        if self.settings_info.is_some() {
+            return slot_ui::hint_row(&[("B", "Close")]);
+        }
+        if let Some(row) = self.in_game_menu.or(self.quick_menu()).filter(|_| {
+            self.diagnostics.is_none()
+                && self.network.is_none()
+                && self.selected_settings_info().is_some()
+        }) {
+            if self.quick_locked(row) {
+                return slot_ui::hint_row(&[("B", "Back"), ("Y", "Info")]);
+            }
+            return slot_ui::hint_row(&[
+                ("B", "Back"),
+                (
+                    if row.opens() { "A" } else { "<>" },
+                    if row.opens() { "Open" } else { "Change" },
+                ),
+                ("Y", "Info"),
+            ]);
+        }
+        if self.shutting_down() {
+            return Vec::new();
+        }
+        if self.state_delete.is_some() {
+            return slot_ui::hint_row(&[("B", "Cancel"), ("A", "Delete")]);
+        }
+        if self.pause_action() {
+            return slot_ui::hint_row(&[("B", "Back"), ("A", "Select")]);
+        }
+        if self.capturing() {
+            return slot_ui::hint_row(&[("F", "Cancel")]);
+        }
+        if self.reset_pending.is_some() {
+            return slot_ui::hint_row(&[("B", "Cancel"), ("A", "Reset")]);
+        }
+        if let Some(menu) = &self.help {
+            return menu.legend();
+        }
+        if let Some(menu) = &self.diagnostics {
+            return menu.legend();
+        }
+        if self.content_open {
+            return slot_ui::hint_row(&[("B", "Back"), ("A", "Refresh")]);
+        }
+        if let Some(menu) = &self.updates {
+            return menu.legend();
+        }
+        if let Some(menu) = &self.network {
+            return menu.legend();
+        }
+        if self.power_menu.is_some() {
