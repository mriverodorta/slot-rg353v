+            a.state.cart = Some("Portable".into());
+            a.snapshot = Some(Box::new(Fixed));
+            let chosen = if game { card.path() } else { system.path() };
+            let other = if game { system.path() } else { card.path() };
+            a.flush_resume();
+            assert_eq!(
+                persist::read_sav(chosen, Platform::Gba, "Portable"),
+                Some(vec![7, 8, 9])
