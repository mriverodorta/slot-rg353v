+#[test]
+fn a_background_drainer_releases_the_ring_after_its_owners_exit() {
+    let mut sink = StubSink::draining();
+    sink.open(GBA_HZ).unwrap();
+    let ring = sink.ring();
+    let weak = std::sync::Arc::downgrade(&ring);
+    ring.push(&ramp(64, 1));
+    let deadline = Instant::now() + Duration::from_secs(2);
+    while ring.queued_frames() > 0 && Instant::now() < deadline {
+        std::thread::sleep(Duration::from_millis(2));
+    }
+    assert_eq!(ring.queued_frames(), 0, "the drainer never consumed audio");
+    drop(ring);
+    drop(sink);
+    let deadline = Instant::now() + Duration::from_secs(2);
+    while weak.strong_count() > 0 && Instant::now() < deadline {
+        std::thread::sleep(Duration::from_millis(2));
+    }
+    assert_eq!(
+        weak.strong_count(),
+        0,
+        "the drainer kept the audio ring alive"
+    );
+}
