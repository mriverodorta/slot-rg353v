+        let mut session = Session::boot_with(root.path().into(), Box::new(StubSink::new()));
+        let join = std::thread::spawn(|| -> Loaded { panic!("opening failed") });
+        while !join.is_finished() {
+            std::thread::yield_now();
+        }
+        session.opening = Some(Opening { join: Some(join) });
+        assert!(session.finish_opening());
+        assert!(!session.has_core());
+        assert!(!session.core_settling());
+    }
+}
