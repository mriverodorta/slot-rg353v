# Local prebuilt package generated by scripts/prepare-rg353v-rocknix.sh.
PKG_NAME="slot-rg353v"
PKG_VERSION="0.1-local"
PKG_LICENSE="GPL-3.0-or-later"
PKG_SITE="https://github.com/BrandonKowalski/slot"
PKG_DEPENDS_TARGET="toolchain slot-bootsplash SDL2 alsa pipewire wireplumber exfatprogs rocknix system-utils ksmbd-tools networkmanager iwd slot-wpa-supplicant Python3 openssl"
PKG_LONGDESC="Experimental slot frontend and patched GB/GBC/GBA cores for RG353V"
PKG_TOOLCHAIN="manual"
# Preserve the separately tested prebuilt frontend/core hashes and save contract.
PKG_BUILD_FLAGS="-strip"

make_target() {
  : # Executable and cores are built and tested separately on the Mac.
}

makeinstall_target() {
  test "${ARCH}" = "aarch64" || return 1
  test "${DEVICE}" = "RK3566" || return 1
  mkdir -p "${INSTALL}/usr/share/slot" "${INSTALL}/usr/bin" "${INSTALL}/usr/lib/systemd/system"
  cp -a "${PKG_DIR}/bundle/System" "${INSTALL}/usr/share/slot/"
  install -m 644 "${PKG_DIR}/config/features-v1" "${INSTALL}/usr/share/slot/features-v1"
  cp "${PKG_DIR}/config/os-profile.json" "${INSTALL}/usr/share/slot/os-profile.json"
  cp "${PKG_DIR}/scripts/slot-wifi-probe-recovery" "${INSTALL}/usr/bin/slot-wifi-probe-recovery"
  chmod 755 "${INSTALL}/usr/bin/slot-wifi-probe-recovery"
  install -m 755 "${PKG_DIR}/scripts/slot-storage-tools" "${INSTALL}/usr/bin/slot-storage-tools"
  install -m 755 "${PKG_DIR}/scripts/slot-module-cleanup" "${INSTALL}/usr/bin/slot-module-cleanup"
  install -m 755 "${PKG_DIR}/scripts/slot-services" "${INSTALL}/usr/bin/slot-services"
  cp "${PKG_DIR}/scripts/slot-network-state" "${INSTALL}/usr/bin/slot-network-state"
  chmod 755 "${INSTALL}/usr/bin/slot-network-state"
  cp "${PKG_DIR}/scripts/slot-ssh" "${INSTALL}/usr/bin/slot-ssh"
  chmod 755 "${INSTALL}/usr/bin/slot-ssh"
  cp "${PKG_DIR}/scripts/slot-usb-storage" "${INSTALL}/usr/bin/slot-usb-storage"
  chmod 755 "${INSTALL}/usr/bin/slot-usb-storage"
  cp "${PKG_DIR}/system.d/slot-usb-storage.service" "${INSTALL}/usr/lib/systemd/system/"
  install -m 755 "${PKG_DIR}/scripts/slot-usb-network" "${INSTALL}/usr/bin/slot-usb-network"
  install -m 755 "${PKG_DIR}/scripts/slot-usb-network-dhcp" "${INSTALL}/usr/bin/slot-usb-network-dhcp"
  install -m 644 "${PKG_DIR}/system.d/slot-usb-network.service" "${INSTALL}/usr/lib/systemd/system/slot-usb-network.service"
  mkdir -p "${INSTALL}/usr/lib/udev/rules.d"
  install -m 644 "${PKG_DIR}/udev.d/75-slot-usb-network.rules" "${INSTALL}/usr/lib/udev/rules.d/75-slot-usb-network.rules"

  install -m 755 "${PKG_DIR}/scripts/slot-ksmbd" "${INSTALL}/usr/bin/slot-ksmbd"
  install -m 644 "${PKG_DIR}/config/ksmbd.conf" "${INSTALL}/usr/share/slot/ksmbd.conf"
  install -m 644 "${PKG_DIR}/system.d/slot-sharing.service" "${INSTALL}/usr/lib/systemd/system/slot-sharing.service"
  cp "${PKG_DIR}/scripts/slot-sharing" "${INSTALL}/usr/bin/slot-sharing"
  chmod 755 "${INSTALL}/usr/bin/slot-sharing"
  cp "${PKG_DIR}/scripts/slot-start" "${INSTALL}/usr/bin/slot-start"
  cp "${PKG_DIR}/scripts/slot-normal-start" "${INSTALL}/usr/bin/slot-normal-start"
  cp "${PKG_DIR}/scripts/slot-os-boot" "${INSTALL}/usr/bin/slot-os-boot"
  chmod 755 "${INSTALL}/usr/bin/slot-normal-start" "${INSTALL}/usr/bin/slot-os-boot"
  cp "${PKG_DIR}/scripts/slot-update" "${INSTALL}/usr/bin/slot-update"
  cp "${PKG_DIR}/scripts/slot-os-update" "${INSTALL}/usr/bin/slot-os-update"
  cp "${PKG_DIR}/scripts/slot-ota" "${INSTALL}/usr/bin/slot-ota"
  chmod 755 "${INSTALL}/usr/bin/slot-update" "${INSTALL}/usr/bin/slot-os-update" "${INSTALL}/usr/bin/slot-ota"
  mkdir -p "${INSTALL}/usr/share/slot/update-keys"
  cp "${PKG_DIR}/config/update-keys/"*.pem "${INSTALL}/usr/share/slot/update-keys/"
  cp "${PKG_DIR}/config/update-feed.json" "${INSTALL}/usr/share/slot/update-feed.json"
  for unit in slot-os-guard slot-os-health slot-wifi-probe-recovery; do
    cp "${PKG_DIR}/system.d/${unit}.service" "${INSTALL}/usr/lib/systemd/system/"
    mkdir -p "${INSTALL}/usr/lib/systemd/system/rocknix.target.wants"
    ln -sf "../${unit}.service" "${INSTALL}/usr/lib/systemd/system/rocknix.target.wants/${unit}.service"
  done
  cp "${PKG_DIR}/config/networkmanager-backend.conf" "${INSTALL}/usr/share/slot/networkmanager-backend.conf"
  mkdir -p "${INSTALL}/usr/lib/systemd/system/NetworkManager.service.d"
  cp "${PKG_DIR}/system.d/30-slot-backend.conf" "${INSTALL}/usr/lib/systemd/system/NetworkManager.service.d/"
  install -m 755 "${PKG_DIR}/scripts/slot-sd-library" "${INSTALL}/usr/bin/slot-sd-library"
  install -m 644 "${PKG_DIR}/system.d/slot-sd-library.service" "${INSTALL}/usr/lib/systemd/system/slot-sd-library.service"
  cp "${PKG_DIR}/scripts/slot-mount-content" "${INSTALL}/usr/bin/slot-mount-content"
  cp "${PKG_DIR}/scripts/slot-content-device" "${INSTALL}/usr/bin/slot-content-device"
  chmod 755 "${INSTALL}/usr/bin/slot-content-device"
  chmod 755 "${INSTALL}/usr/bin/slot-start" "${INSTALL}/usr/bin/slot-mount-content"
  mkdir -p "${INSTALL}/usr/config/slot-iwd" "${INSTALL}/usr/lib/systemd/system/iwd.service.d"
  cp "${PKG_DIR}/config/iwd-main.conf" "${INSTALL}/usr/config/slot-iwd/main.conf"
  cp "${PKG_DIR}/system.d/20-slot-interface.conf" "${INSTALL}/usr/lib/systemd/system/iwd.service.d/"
  mkdir -p "${INSTALL}/usr/config/autostart"
  cp "${PKG_DIR}/scripts/slot-wifi-diagnostics" "${INSTALL}/usr/config/autostart/091-slot-wifi-diagnostics"
  chmod 755 "${INSTALL}/usr/config/autostart/091-slot-wifi-diagnostics"
  cp "${PKG_DIR}/system.d/slot-rg353v.service" "${INSTALL}/usr/lib/systemd/system/"
  cp "${PKG_DIR}/system.d/storage-slotcontent.service" "${INSTALL}/usr/lib/systemd/system/"
  mkdir -p "${INSTALL}/usr/lib/systemd/system/rocknix.target.wants"
  ln -sf ../slot-wpa-supplicant.service "${INSTALL}/usr/lib/systemd/system/rocknix.target.wants/slot-wpa-supplicant.service"
  ln -sf ../storage-slotcontent.service "${INSTALL}/usr/lib/systemd/system/rocknix.target.wants/storage-slotcontent.service"
  ln -sf ../slot-rg353v.service "${INSTALL}/usr/lib/systemd/system/rocknix.target.wants/slot-rg353v.service"
}

post_makeinstall_target() {
  # The Slot BASE_ONLY image must not launch the upstream compositor afterward.
  for unit in sway.service essway.service emustation.service; do
    ln -sf /dev/null "${INSTALL}/usr/lib/systemd/system/$unit"
  done
}

post_install() {
  python3 "${PKG_DIR}/../slot-bootsplash/tools/patch-autostart.py" "${INSTALL}/usr/bin/autostart" || return 1
  python3 "${PKG_DIR}/tools/patch-input-autostart.py" "${INSTALL}/usr/lib/autostart/common/098-deviceutils" || return 1
  python3 "${PKG_DIR}/tools/configure-usb-storage.py" "${INSTALL}" || return 1
  python3 "${PKG_DIR}/tools/patch-chksysconfig.py" "${INSTALL}/usr/bin/chksysconfig" || return 1
  # Change only the installed RG353V image, preserving the official source unit
  # and all its other dependencies. Keep iwd available for an explicit fallback.
  local unit="${INSTALL}/usr/lib/systemd/system/NetworkManager.service"
  test -f "${unit}" || return 1
  sed 's/iwd[.]service/slot-wpa-supplicant.service/g' "${unit}" > "${unit}.slot-tmp"
  mv -f "${unit}.slot-tmp" "${unit}"
  local link
  for link in "${INSTALL}/usr/lib/systemd/system/"*.target.wants/iwd.service; do
    if [ -L "${link}" ]; then rm -f "${link}"; fi
  done
}
